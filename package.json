{
  "name": "@rueblibuebli/neumorph-ui",
  "version": "1.0.0",
  "description": "Neumorphic (soft UI) React component and style library",
  "type": "module",
  "license": "MIT",
  "author": "RuebliBuebli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuebliBuebli/neumorph-ui.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/neumorph-ui.cjs.js",
  "module": "./dist/neumorph-ui.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/neumorph-ui.es.js",
      "require": "./dist/neumorph-ui.cjs.js"
    },
    "./styles.css": "./dist/neumorph-ui.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "playground": "npm run dev --workspace playground"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "workspaces": [
    "playground"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "stylelint": "^16.25.0",
    "stylelint-config-standard": "^39.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^3.2.4"
  }
}
